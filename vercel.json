{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{assets,node_modules}/**"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/admin/?", "dest": "/api/index.php" },
    { "src": "/.*\\.php", "dest": "/api/index.php" }
  ]
}
